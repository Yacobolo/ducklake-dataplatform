{
  "$defs": {
    "CellSpec": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "disabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "test": {
          "$ref": "#/$defs/NotebookTestSpec"
        },
        "type": {
          "type": "string"
        },
        "visual_spec": {
          "$ref": "#/$defs/VisualSpec"
        }
      },
      "required": [
        "content",
        "type"
      ],
      "type": "object"
    },
    "NotebookDoc": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "enum": [
            "duck/v1"
          ],
          "type": "string"
        },
        "kind": {
          "enum": [
            "Notebook"
          ],
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/ObjectMeta"
        },
        "spec": {
          "$ref": "#/$defs/NotebookSpec"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "type": "object"
    },
    "NotebookPublishModelSpec": {
      "additionalProperties": false,
      "properties": {
        "materialization": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "output_cell": {
          "type": "string"
        },
        "project": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "output_cell",
        "project"
      ],
      "type": "object"
    },
    "NotebookPublishSpec": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "#/$defs/NotebookPublishModelSpec"
        }
      },
      "type": "object"
    },
    "NotebookSpec": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "items": {
            "$ref": "#/$defs/CellSpec"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "publish": {
          "$ref": "#/$defs/NotebookPublishSpec"
        }
      },
      "type": "object"
    },
    "NotebookTestSpec": {
      "additionalProperties": false,
      "properties": {
        "severity": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "properties": {
        "deletion_protection": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "VisualEncodings": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/VisualFieldBinding"
        },
        "secondary": {
          "$ref": "#/$defs/VisualFieldBinding"
        },
        "series": {
          "$ref": "#/$defs/VisualFieldBinding"
        },
        "value": {
          "$ref": "#/$defs/VisualFieldBinding"
        },
        "x": {
          "$ref": "#/$defs/VisualFieldBinding"
        },
        "y": {
          "$ref": "#/$defs/VisualFieldBinding"
        }
      },
      "type": "object"
    },
    "VisualFieldBinding": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "type": "object"
    },
    "VisualSpec": {
      "additionalProperties": false,
      "properties": {
        "chart_type": {
          "type": "string"
        },
        "color_palette": {
          "type": "string"
        },
        "encodings": {
          "$ref": "#/$defs/VisualEncodings"
        },
        "kind": {
          "type": "string"
        },
        "legend": {
          "type": "boolean"
        },
        "legend_position": {
          "type": "string"
        },
        "stacked": {
          "type": "boolean"
        },
        "subtitle": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    }
  },
  "$id": "schemas/declarative/v1/kinds/notebook.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "#/$defs/NotebookDoc"
    }
  ],
  "title": "Duck declarative Notebook"
}
