{
  "$defs": {
    "CellSpec": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string"
        },
        "disabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "test": {
          "$ref": "#/$defs/NotebookTestSpec"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "content",
        "type"
      ],
      "type": "object"
    },
    "NotebookDoc": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "enum": [
            "duck/v1"
          ],
          "type": "string"
        },
        "kind": {
          "enum": [
            "Notebook"
          ],
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/ObjectMeta"
        },
        "spec": {
          "$ref": "#/$defs/NotebookSpec"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "type": "object"
    },
    "NotebookPublishModelSpec": {
      "additionalProperties": false,
      "properties": {
        "materialization": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "output_cell": {
          "type": "string"
        },
        "project": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "output_cell",
        "project"
      ],
      "type": "object"
    },
    "NotebookPublishSpec": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "#/$defs/NotebookPublishModelSpec"
        }
      },
      "type": "object"
    },
    "NotebookSpec": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "items": {
            "$ref": "#/$defs/CellSpec"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "publish": {
          "$ref": "#/$defs/NotebookPublishSpec"
        }
      },
      "type": "object"
    },
    "NotebookTestSpec": {
      "additionalProperties": false,
      "properties": {
        "severity": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "properties": {
        "deletion_protection": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  },
  "$id": "schemas/declarative/v1/kinds/notebook.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "#/$defs/NotebookDoc"
    }
  ],
  "title": "Duck declarative Notebook"
}
