{
  "$defs": {
    "AssetCheckSpec": {
      "additionalProperties": false,
      "properties": {
        "check_type": {
          "type": "string"
        },
        "config": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        }
      },
      "required": [
        "check_type",
        "name"
      ],
      "type": "object"
    },
    "AssetDoc": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "enum": [
            "duck/v1"
          ],
          "type": "string"
        },
        "kind": {
          "enum": [
            "Asset"
          ],
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/ObjectMeta"
        },
        "spec": {
          "$ref": "#/$defs/AssetSpec"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "type": "object"
    },
    "AssetSpec": {
      "additionalProperties": false,
      "properties": {
        "asset_type": {
          "type": "string"
        },
        "auto_materialize": {
          "type": "boolean"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/AssetCheckSpec"
          },
          "type": "array"
        },
        "cron_schedule": {
          "type": "string"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "type": "string"
        },
        "io_profile": {
          "type": "string"
        },
        "max_lag_seconds": {
          "type": "integer"
        },
        "owner": {
          "type": "string"
        },
        "partition_type": {
          "type": "string"
        },
        "properties": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "ObjectMeta": {
      "additionalProperties": false,
      "properties": {
        "deletion_protection": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  },
  "$id": "schemas/declarative/v1/kinds/asset.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "#/$defs/AssetDoc"
    }
  ],
  "title": "Duck declarative Asset"
}
