{{ define "docs" -}}
<main class="mx-auto grid max-w-[88rem] lg:min-h-[calc(100vh-4.5rem)] lg:grid-cols-[18rem_minmax(0,1fr)] xl:grid-cols-[18rem_minmax(0,1fr)_16rem]">
  {{ template "docs_sidebar" . }}
  <article class="min-w-0 px-4 py-8 sm:px-6 lg:px-10 lg:py-10 xl:px-12">
    {{ template "docs_breadcrumbs" . }}
    <div class="site-prose">
      <h1>{{ .Page.Title }}</h1>
      {{ if and .Page.Description (ne .Page.Kind "api") }}<p>{{ .Page.Description }}</p>{{ end }}
      {{ .BodyHTML }}
    </div>
    {{ template "docs_pager" . }}
  </article>
  {{ template "docs_toc" . }}
</main>
{{- end }}
