{{ define "docs" -}}
<main class="mx-auto grid max-w-[88rem] lg:min-h-[calc(100vh-4.5rem)] lg:grid-cols-[18rem_minmax(0,1fr)] xl:grid-cols-[18rem_minmax(0,1fr)_16rem]">
  {{ template "docs_sidebar" . }}
  <article class="min-w-0 px-4 py-8 sm:px-6 lg:px-10 lg:py-10 xl:px-12">
    {{ template "docs_breadcrumbs" . }}
    <div data-page-prose class="prose max-w-none prose-headings:[font-family:'Space_Grotesk',ui-sans-serif,system-ui,sans-serif] prose-headings:tracking-[-0.03em] prose-headings:text-[var(--fgColor-default)] prose-p:text-[var(--fgColor-muted)] prose-li:text-[var(--fgColor-muted)] prose-li:marker:text-[var(--fgColor-accent)] prose-strong:text-[var(--fgColor-default)] prose-a:text-[var(--fgColor-accent)] prose-a:decoration-[0.08em] prose-a:underline-offset-[0.18em] prose-code:rounded prose-code:bg-[color:color-mix(in_srgb,var(--fgColor-accent)_10%,transparent)] prose-code:px-1.5 prose-code:py-0.5 prose-code:text-sm prose-code:text-[var(--fgColor-default)] prose-code:before:content-none prose-code:after:content-none prose-pre:overflow-x-auto prose-pre:rounded-2xl prose-pre:bg-[var(--bgColor-emphasis)] prose-pre:p-4 prose-pre:text-sm prose-pre:text-[var(--fgColor-onEmphasis)] prose-img:rounded-3xl prose-img:border prose-img:border-[var(--borderColor-default)] prose-img:bg-[var(--bgColor-inset)] prose-hr:border-[var(--borderColor-muted)] prose-th:text-[var(--fgColor-default)] prose-td:text-[var(--fgColor-default)] prose-table:m-0 prose-table:min-w-full prose-table:border-collapse prose-table:text-sm prose-th:border-x-0 prose-th:border-t prose-th:border-b-0 prose-th:border-[var(--borderColor-muted)] prose-th:px-4 prose-th:py-3 prose-th:text-left prose-th:align-top prose-th:text-base prose-th:font-semibold prose-th:tracking-normal prose-td:border-x-0 prose-td:border-t prose-td:border-b-0 prose-td:border-[var(--borderColor-muted)] prose-td:px-4 prose-td:py-3 prose-td:text-left prose-td:align-top [&_h2]:scroll-mt-[6.5rem] [&_h3]:scroll-mt-[6.5rem] [&_.contains-task-list]:list-none [&_.contains-task-list]:pl-0 [&_.task-list-item]:list-none [&_.task-list-item]:pl-0 [&_.task-list-item_input[type='checkbox']]:mr-3 [&_.task-list-item_input[type='checkbox']]:accent-[var(--fgColor-accent)] {{ if eq .Page.Kind `api` }}[&_>h1]:hidden [&_>h2]:rounded-[1.75rem] [&_>h2]:border [&_>h2]:border-[var(--borderColor-default)] [&_>h2]:bg-[color:color-mix(in_srgb,var(--bgColor-muted)_68%,var(--bgColor-inset))] [&_>h2]:px-5 [&_>h2]:py-4 [&_>h2]:text-xl [&_>h3]:mt-6 [&_>h3]:text-base [&_>h3]:font-semibold [&_>h3]:uppercase [&_>h3]:tracking-[0.15em]{{ end }}">
      <h1>{{ .Page.Title }}</h1>
      {{ if and .Page.Description (ne .Page.Kind "api") }}<p>{{ .Page.Description }}</p>{{ end }}
      {{ .BodyHTML }}
    </div>
    {{ template "docs_pager" . }}
  </article>
  {{ template "docs_toc" . }}
</main>
{{- end }}
