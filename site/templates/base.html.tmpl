{{ define "base" -}}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .MetaTitle }}</title>
  <meta name="description" content="{{ .Page.Description }}">
  <link rel="icon" href="/_site/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/_site/site.css">
</head>
<body>
  <div class="site-shell {{ if eq .Page.Kind `api` }}api-shell{{ end }}">
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-logo" href="/">
          <img src="/_site/favicon.svg" alt="" class="h-8 w-8">
          <span>{{ .Site.Title }}</span>
        </a>
        <nav class="site-nav">
          {{ range .TopNav }}
            <a href="{{ .Path }}"{{ if .Active }} class="is-active"{{ end }}>{{ .Title }}</a>
          {{ end }}
        </nav>
        <div class="site-actions">
          <input data-site-search-input type="search" placeholder="{{ if eq .Page.Kind `api` }}Search API{{ else }}Search docs{{ end }}" class="hidden rounded-full border px-4 py-2 text-sm lg:block">
          <button data-site-theme-toggle type="button" class="site-button site-button-secondary">Dark</button>
          <button data-site-nav-toggle type="button" class="site-button site-button-secondary lg:hidden">Menu</button>
        </div>
      </div>
      <div data-site-mobile-nav class="site-mobile-nav">
        <nav class="space-y-3">
          {{ range .TopNav }}
            <a class="block no-underline" href="{{ .Path }}">{{ .Title }}</a>
          {{ end }}
        </nav>
      </div>
      <div data-site-search-results class="mx-auto hidden max-w-7xl px-4 pb-4 lg:block lg:px-8"></div>
    </header>
    {{ if .Page.IsHome }}
      {{ template "home" . }}
    {{ else if eq .Page.Kind "api" }}
      {{ template "api" . }}
    {{ else }}
      {{ template "docs" . }}
    {{ end }}
  </div>
  <script src="/_site/site.js"></script>
</body>
</html>
{{- end }}
