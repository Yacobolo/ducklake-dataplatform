{{ define "base" -}}
<!doctype html>
<html lang="en" data-color-mode="light" data-light-theme="light" data-dark-theme="dark" data-site-root="{{ .SiteRoot }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .MetaTitle }}</title>
  <meta name="description" content="{{ .Page.Description }}">
  <script>
    (function () {
      var stored = "system";
      try {
        stored = localStorage.getItem("duck-site-theme") || "system";
      } catch (_) {}
      var resolved = stored === "system"
        ? (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
        : stored;
      if (stored === "system") {
        document.documentElement.setAttribute("data-color-mode", "auto");
        document.documentElement.setAttribute("data-light-theme", resolved);
        document.documentElement.setAttribute("data-dark-theme", "dark");
      } else {
        document.documentElement.setAttribute("data-color-mode", resolved);
        document.documentElement.setAttribute("data-light-theme", "light");
        document.documentElement.setAttribute("data-dark-theme", "dark");
      }
      document.documentElement.setAttribute("data-theme", resolved);
      document.documentElement.setAttribute("data-theme-preference", stored);
    })();
  </script>
  <link rel="icon" href="{{ siteURL .SiteRoot "/_site/favicon.svg" }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ siteURL .SiteRoot "/_site/site.css" }}">
</head>
<body>
  <div class="site-shell">
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-logo" href="{{ siteURL .SiteRoot "/" }}">
          <img src="{{ siteURL .SiteRoot "/_site/favicon.svg" }}" alt="" class="h-8 w-8">
          <span>{{ .Site.Title }}</span>
        </a>
        <nav class="site-nav">
          {{ range .TopNav }}
            <a href="{{ siteURL $.SiteRoot .Path }}"{{ if .Active }} class="is-active"{{ end }}>{{ .Title }}</a>
          {{ end }}
        </nav>
        <div class="site-actions">
          <button data-site-search-open type="button" class="site-search-trigger site-button-secondary" aria-label="Open search" title="Open search">
            <svg class="site-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
            <span>Search</span>
          </button>
          <a href="https://github.com/Yacobolo/ducklake-dataplatform" class="site-icon-button site-button-secondary" aria-label="Open GitHub repository" title="Open GitHub repository" target="_blank" rel="noreferrer">
            <span class="sr-only">GitHub repository</span>
            <svg class="site-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.11.79-.25.79-.56 0-.28-.01-1.2-.02-2.17-3.2.7-3.88-1.35-3.88-1.35-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.69.08-.69 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.72-1.55-2.56-.29-5.25-1.28-5.25-5.72 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18A11 11 0 0 1 12 6.08c.98 0 1.97.13 2.9.38 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.45-2.69 5.43-5.26 5.71.41.36.78 1.08.78 2.18 0 1.57-.01 2.83-.01 3.22 0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"></path>
            </svg>
          </a>
          <button data-site-theme-toggle type="button" class="site-icon-button site-button-secondary" aria-label="Theme: system" title="Theme: system">
            <span class="sr-only">Theme</span>
            <span class="site-theme-icon" data-theme-icon="system" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
              </svg>
            </span>
            <span class="site-theme-icon" data-theme-icon="light" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2"></path>
                <path d="M12 20v2"></path>
                <path d="m4.93 4.93 1.41 1.41"></path>
                <path d="m17.66 17.66 1.41 1.41"></path>
                <path d="M2 12h2"></path>
                <path d="M20 12h2"></path>
                <path d="m6.34 17.66-1.41 1.41"></path>
                <path d="m19.07 4.93-1.41 1.41"></path>
              </svg>
            </span>
            <span class="site-theme-icon" data-theme-icon="dark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9"></path>
              </svg>
            </span>
          </button>
          <button data-site-nav-toggle type="button" class="site-icon-button site-button-secondary lg:hidden" aria-label="Open menu" title="Open menu">
            <span class="sr-only">Menu</span>
            <svg class="site-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="4" y1="12" x2="20" y2="12"></line>
              <line x1="4" y1="6" x2="20" y2="6"></line>
              <line x1="4" y1="18" x2="20" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
      <div data-site-mobile-nav class="site-mobile-nav">
        <nav class="space-y-3">
          {{ range .TopNav }}
            <a class="block no-underline" href="{{ siteURL $.SiteRoot .Path }}">{{ .Title }}</a>
          {{ end }}
        </nav>
      </div>
    </header>
    <div data-site-search-modal class="site-search-modal" hidden>
      <div data-site-search-backdrop class="site-search-backdrop"></div>
      <div class="site-search-shell">
        <section class="site-search-dialog" role="dialog" aria-modal="true" aria-labelledby="site-search-title">
          <div class="site-search-header">
            <div>
              <p class="site-search-eyebrow">Search</p>
              <h2 id="site-search-title" class="site-search-title">{{ if eq .Page.Kind `api` }}Search API reference{{ else }}Search docs{{ end }}</h2>
            </div>
            <button data-site-search-close type="button" class="site-icon-button site-button-secondary" aria-label="Close search" title="Close search">
              <svg class="site-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
              </svg>
            </button>
          </div>
          <div class="site-search-input-wrap">
            <svg class="site-search-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
            <input data-site-search-input type="search" class="site-search-input" placeholder="{{ if eq .Page.Kind `api` }}Search endpoints, models, and operations{{ else }}Search pages, sections, and headings{{ end }}" autocomplete="off">
          </div>
          <div data-site-search-results class="site-search-results"></div>
        </section>
      </div>
    </div>
    {{ if .Page.IsHome }}
      {{ template "home" . }}
    {{ else }}
      {{ template "docs" . }}
    {{ end }}
  </div>
  <script src="{{ siteURL .SiteRoot "/_site/site.js" }}"></script>
</body>
</html>
{{- end }}
