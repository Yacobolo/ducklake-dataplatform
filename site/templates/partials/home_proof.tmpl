{{ define "home_proof" -}}
<div class="inline-flex items-center gap-2 rounded-full border border-[var(--borderColor-default)] bg-[color:color-mix(in_srgb,var(--bgColor-inset)_88%,transparent)] px-3 py-2 text-sm text-[var(--fgColor-muted)]">
  <span class="inline-flex h-4 w-4 shrink-0 text-[var(--fgColor-accent)]" aria-hidden="true">{{ navIcon .Icon }}</span>
  <span>{{ .Text }}</span>
</div>
{{- end }}
