{{ define "site_search_modal" -}}
<div data-site-search-modal class="fixed inset-0 z-50" hidden>
  <div data-site-search-backdrop class="absolute inset-0 bg-[color:color-mix(in_srgb,var(--bgColor-default)_44%,transparent)]"></div>
  <div class="relative z-10 mx-auto flex min-h-full w-full max-w-4xl items-start justify-center px-4 py-10 lg:py-16">
    <section class="w-full rounded-[2rem] border border-[var(--borderColor-default)] bg-[linear-gradient(180deg,color-mix(in_srgb,var(--bgColor-inset)_96%,transparent),color-mix(in_srgb,var(--bgColor-muted)_38%,var(--bgColor-inset)))] p-5 shadow-[0_28px_80px_color-mix(in_srgb,var(--fgColor-default)_24%,transparent)] lg:p-6" role="dialog" aria-modal="true" aria-labelledby="site-search-title">
      <div class="mb-5 flex items-start justify-between gap-4">
        <div>
          <p class="text-[0.74rem] font-semibold uppercase tracking-[0.24em] text-[var(--fgColor-accent)]">Search</p>
          <h2 id="site-search-title" class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-[var(--fgColor-default)] [font-family:'Space_Grotesk',ui-sans-serif,system-ui,sans-serif]">{{ if eq .Page.Kind `api` }}Search API reference{{ else }}Search docs{{ end }}</h2>
        </div>
        <button data-site-search-close type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-[var(--borderColor-default)] bg-[var(--bgColor-inset)] p-0 text-[var(--fgColor-default)] transition hover:border-[color:color-mix(in_srgb,var(--fgColor-accent)_35%,var(--borderColor-default))] hover:bg-[var(--bgColor-muted)]" aria-label="Close search" title="Close search">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
      <div class="flex items-center gap-3 rounded-[1.5rem] border border-[var(--borderColor-default)] bg-[var(--bgColor-default)] px-4 py-3 focus-within:border-[color:color-mix(in_srgb,var(--fgColor-accent)_35%,var(--borderColor-default))] focus-within:shadow-[0_0_0_4px_color-mix(in_srgb,var(--fgColor-accent)_12%,transparent)]">
        <svg class="h-5 w-5 shrink-0 text-[var(--fgColor-muted)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input data-site-search-input type="search" class="min-w-0 flex-1 border-0 bg-transparent p-0 text-base text-[var(--fgColor-default)] outline-none placeholder:text-[var(--fgColor-muted)]" placeholder="{{ if eq .Page.Kind `api` }}Search endpoints, models, and operations{{ else }}Search pages, sections, and headings{{ end }}" autocomplete="off">
      </div>
      <div data-site-search-results class="mt-4 max-h-[65vh] space-y-3 overflow-y-auto pr-1"></div>
    </section>
  </div>
</div>
{{- end }}
