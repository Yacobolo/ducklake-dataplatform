{{ define "site_header" -}}
<header class="sticky top-0 z-40 border-b border-[var(--borderColor-default)] bg-[color:color-mix(in_srgb,var(--bgColor-default)_82%,transparent)] [backdrop-filter:blur(18px)]">
  <div class="mx-auto flex max-w-[88rem] items-center gap-3 px-4 py-3 lg:px-8">
    <a class="inline-flex items-center gap-3 text-[var(--fgColor-default)] no-underline" href="{{ siteURL .SiteRoot "/" }}">
      <img src="{{ siteURL .SiteRoot "/_site/favicon.svg" }}" alt="" class="h-8 w-8">
      <span class="[font-family:'Space_Grotesk',ui-sans-serif,system-ui,sans-serif] font-semibold tracking-[-0.02em]">{{ .Site.Title }}</span>
    </a>
    <nav class="ml-4 hidden items-center gap-1 lg:flex">
      {{ range .TopNav }}
        <a href="{{ siteURL $.SiteRoot .Path }}" class="rounded-full px-4 py-2 text-sm font-medium text-[var(--fgColor-muted)] no-underline transition hover:bg-[color:color-mix(in_srgb,var(--bgColor-muted)_86%,transparent)] hover:text-[var(--fgColor-default)] [&.is-active]:bg-[color:color-mix(in_srgb,var(--bgColor-muted)_86%,transparent)] [&.is-active]:text-[var(--fgColor-default)] {{ if .Active }}is-active{{ end }}">{{ .Title }}</a>
      {{ end }}
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <button data-site-search-open type="button" class="hidden items-center gap-2 rounded-full border border-[var(--borderColor-default)] bg-[var(--bgColor-inset)] px-4 py-2 text-sm font-medium text-[var(--fgColor-default)] transition hover:border-[color:color-mix(in_srgb,var(--fgColor-accent)_35%,var(--borderColor-default))] hover:bg-[var(--bgColor-muted)] lg:inline-flex" aria-label="Open search" title="Open search">
        <svg class="h-4 w-4 text-[var(--fgColor-muted)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <span>Search</span>
      </button>
      <a href="https://github.com/Yacobolo/ducklake-dataplatform" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-[var(--borderColor-default)] bg-[var(--bgColor-inset)] p-0 text-[var(--fgColor-default)] transition hover:border-[color:color-mix(in_srgb,var(--fgColor-accent)_35%,var(--borderColor-default))] hover:bg-[var(--bgColor-muted)]" aria-label="Open GitHub repository" title="Open GitHub repository" target="_blank" rel="noreferrer">
        <span class="sr-only">GitHub repository</span>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.11.79-.25.79-.56 0-.28-.01-1.2-.02-2.17-3.2.7-3.88-1.35-3.88-1.35-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.69.08-.69 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.72-1.55-2.56-.29-5.25-1.28-5.25-5.72 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18A11 11 0 0 1 12 6.08c.98 0 1.97.13 2.9.38 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.45-2.69 5.43-5.26 5.71.41.36.78 1.08.78 2.18 0 1.57-.01 2.83-.01 3.22 0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"></path>
        </svg>
      </a>
      <button data-site-theme-toggle type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-[var(--borderColor-default)] bg-[var(--bgColor-inset)] p-0 text-[var(--fgColor-default)] transition hover:border-[color:color-mix(in_srgb,var(--fgColor-accent)_35%,var(--borderColor-default))] hover:bg-[var(--bgColor-muted)]" aria-label="Theme: system" title="Theme: system">
        <span class="sr-only">Theme</span>
        <span class="hidden h-4 w-4" data-theme-icon="system" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </span>
        <span class="hidden h-4 w-4" data-theme-icon="light" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
        </span>
        <span class="hidden h-4 w-4" data-theme-icon="dark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9"></path>
          </svg>
        </span>
      </button>
      <button data-site-nav-toggle type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-[var(--borderColor-default)] bg-[var(--bgColor-inset)] p-0 text-[var(--fgColor-default)] transition hover:border-[color:color-mix(in_srgb,var(--fgColor-accent)_35%,var(--borderColor-default))] hover:bg-[var(--bgColor-muted)] lg:hidden" aria-label="Open menu" title="Open menu">
        <span class="sr-only">Menu</span>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
  <div data-site-mobile-nav class="hidden border-t border-[var(--borderColor-default)] bg-[color:color-mix(in_srgb,var(--bgColor-inset)_92%,transparent)]">
    <nav class="mx-auto flex max-w-[88rem] flex-col gap-2 px-4 py-4 lg:px-8">
      {{ range .TopNav }}
        <a class="block rounded-full px-4 py-2 text-sm font-medium text-[var(--fgColor-muted)] no-underline transition hover:bg-[color:color-mix(in_srgb,var(--bgColor-muted)_86%,transparent)] hover:text-[var(--fgColor-default)] [&.is-active]:bg-[color:color-mix(in_srgb,var(--bgColor-muted)_86%,transparent)] [&.is-active]:text-[var(--fgColor-default)] {{ if .Active }}is-active{{ end }}" href="{{ siteURL $.SiteRoot .Path }}">{{ .Title }}</a>
      {{ end }}
    </nav>
  </div>
</header>
{{- end }}
