{{ define "home_cta" -}}
<a href="{{ siteURL .SiteRoot .Action.Link }}" class="{{ if eq .Action.Theme `brand` }}inline-flex items-center justify-center rounded-full bg-[color:var(--site-brand)] px-5 py-3 text-sm font-semibold text-[color:var(--site-brand-ink)] no-underline shadow-[0_18px_42px_color-mix(in_srgb,var(--site-brand)_18%,transparent)] transition duration-200 hover:translate-y-[-1px] hover:bg-[color:var(--site-brand-strong)]{{ else }}inline-flex items-center justify-center rounded-full border border-[color:var(--site-border)] bg-[color:var(--site-panel)] px-5 py-3 text-sm font-semibold text-[color:var(--site-ink)] no-underline transition duration-200 hover:border-[color:color-mix(in_srgb,var(--site-brand)_35%,var(--site-border))] hover:bg-[color:var(--site-soft)]{{ end }}">{{ .Action.Text }}</a>
{{- end }}
