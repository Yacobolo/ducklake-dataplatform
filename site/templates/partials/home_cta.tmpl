{{ define "home_cta" -}}
<a href="{{ siteURL .SiteRoot .Action.Link }}" class="{{ if eq .Action.Theme `brand` }}inline-flex items-center justify-center rounded-full bg-[var(--button-primary-bgColor-rest)] px-5 py-3 text-sm font-semibold text-[var(--button-primary-fgColor-rest)] no-underline shadow-[0_18px_42px_color-mix(in_srgb,var(--button-primary-bgColor-rest)_18%,transparent)] transition duration-200 hover:translate-y-[-1px] hover:bg-[var(--button-primary-bgColor-hover)] active:bg-[var(--button-primary-bgColor-active)]{{ else }}inline-flex items-center justify-center rounded-full border border-[var(--button-default-borderColor-rest)] bg-[var(--button-default-bgColor-rest)] px-5 py-3 text-sm font-semibold text-[var(--button-default-fgColor-rest)] no-underline transition duration-200 hover:border-[var(--button-default-borderColor-hover)] hover:bg-[var(--button-default-bgColor-hover)] active:border-[var(--button-default-borderColor-active)] active:bg-[var(--button-default-bgColor-active)]{{ end }}">{{ .Action.Text }}</a>
{{- end }}
