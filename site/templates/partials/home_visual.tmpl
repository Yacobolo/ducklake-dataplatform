{{ define "home_visual" -}}
<div class="flex flex-col gap-4" data-home-reveal style="--home-delay: 180ms;">
  <div class="hidden rounded-[2rem] border border-[var(--borderColor-default)] bg-[linear-gradient(180deg,color-mix(in_srgb,var(--bgColor-inset)_96%,transparent),color-mix(in_srgb,var(--bgColor-muted)_56%,var(--bgColor-inset)))] p-4 shadow-[0_24px_72px_color-mix(in_srgb,var(--fgColor-accent)_8%,transparent)] lg:block">
    <svg class="home-diagram h-auto w-full text-[var(--fgColor-accent)]" viewBox="0 0 960 220" role="img" aria-label="Diagram showing access surfaces, a governed gateway, and DuckLake with DuckDB execution.">
      <g class="home-diagram-rails" aria-hidden="true">
        <path class="home-diagram-rail" d="M236 74H722"></path>
        <path class="home-diagram-rail" d="M236 110H722"></path>
        <path class="home-diagram-rail" d="M236 146H722"></path>
      </g>
      <g class="home-diagram-pulses" aria-hidden="true">
        <circle class="home-diagram-pulse home-diagram-pulse-a" cx="270" cy="74" r="6"></circle>
        <circle class="home-diagram-pulse home-diagram-pulse-b" cx="332" cy="110" r="6"></circle>
        <circle class="home-diagram-pulse home-diagram-pulse-c" cx="394" cy="146" r="6"></circle>
      </g>
      <g transform="translate(40 38)">
        <rect class="home-diagram-panel" x="0" y="0" width="180" height="144" rx="26"></rect>
        <text class="home-diagram-kicker" x="90" y="30">access surfaces</text>
        <g class="home-diagram-pill" transform="translate(22 52)">
          <rect x="0" y="0" width="62" height="28" rx="14"></rect>
          <text x="31" y="19">browser</text>
        </g>
        <g class="home-diagram-pill" transform="translate(96 52)">
          <rect x="0" y="0" width="62" height="28" rx="14"></rect>
          <text x="31" y="19">sql</text>
        </g>
        <g class="home-diagram-pill" transform="translate(22 92)">
          <rect x="0" y="0" width="62" height="28" rx="14"></rect>
          <text x="31" y="19">api</text>
        </g>
        <g class="home-diagram-pill" transform="translate(96 92)">
          <rect x="0" y="0" width="62" height="28" rx="14"></rect>
          <text x="31" y="19">cli</text>
        </g>
      </g>
      <g transform="translate(390 26)">
        <rect class="home-diagram-core" x="0" y="0" width="180" height="168" rx="32"></rect>
        <text class="home-diagram-kicker" x="90" y="34">governed gateway</text>
        <text class="home-diagram-title" x="90" y="72">policy in path</text>
        <g class="home-diagram-chip" transform="translate(24 102)">
          <rect x="0" y="0" width="52" height="22" rx="11"></rect>
          <text x="26" y="15">rbac</text>
        </g>
        <g class="home-diagram-chip" transform="translate(86 102)">
          <rect x="0" y="0" width="64" height="22" rx="11"></rect>
          <text x="32" y="15">filters</text>
        </g>
        <g class="home-diagram-chip" transform="translate(54 132)">
          <rect x="0" y="0" width="70" height="22" rx="11"></rect>
          <text x="35" y="15">masks</text>
        </g>
      </g>
      <g transform="translate(740 38)">
        <rect class="home-diagram-panel" x="0" y="0" width="180" height="144" rx="26"></rect>
        <text class="home-diagram-kicker" x="90" y="30">execution</text>
        <text class="home-diagram-data" x="90" y="78">DuckLake</text>
        <text class="home-diagram-data" x="90" y="116">DuckDB</text>
      </g>
    </svg>
  </div>
  <div class="grid gap-3 sm:grid-cols-2 lg:hidden">
    <div class="rounded-[1.4rem] border border-[var(--borderColor-default)] bg-[var(--bgColor-inset)] px-4 py-4">
      <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-[var(--fgColor-accent)]">{{ .HomeView.Hero.Visual.AccessTitle }}</p>
      <p class="mt-2 text-base font-medium text-[var(--fgColor-default)]">{{ .HomeView.Hero.Visual.AccessValue }}</p>
    </div>
    <div class="rounded-[1.4rem] border border-[color:color-mix(in_srgb,var(--fgColor-accent)_28%,var(--borderColor-default))] bg-[color:color-mix(in_srgb,var(--bgColor-muted)_88%,var(--bgColor-inset))] px-4 py-4">
      <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-[var(--fgColor-accent)]">{{ .HomeView.Hero.Visual.PolicyTitle }}</p>
      <p class="mt-2 text-base font-medium text-[var(--fgColor-default)]">{{ .HomeView.Hero.Visual.PolicyValue }}</p>
    </div>
    <div class="rounded-[1.4rem] border border-[var(--borderColor-default)] bg-[var(--bgColor-inset)] px-4 py-4 sm:col-span-2">
      <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-[var(--fgColor-accent)]">{{ .HomeView.Hero.Visual.ExecutionTitle }}</p>
      <p class="mt-2 text-base font-medium text-[var(--fgColor-default)]">{{ .HomeView.Hero.Visual.ExecutionValue }}</p>
    </div>
  </div>
  <div class="rounded-[1.6rem] border border-[var(--borderColor-default)] bg-[color:color-mix(in_srgb,var(--bgColor-inset)_92%,transparent)] p-5">
    <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-[var(--fgColor-accent)]">{{ .HomeView.Hero.SnapshotTitle }}</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {{ range .HomeView.Hero.Snapshot }}
        <div class="rounded-[1.1rem] border border-[var(--borderColor-muted)] bg-[var(--bgColor-default)] px-4 py-4">
          <div class="flex items-center gap-3">
            <span class="inline-flex h-5 w-5 shrink-0 text-[var(--fgColor-accent)]" aria-hidden="true">{{ navIcon .Icon }}</span>
            <p class="text-sm font-semibold text-[var(--fgColor-default)]">{{ .Label }}</p>
          </div>
          <p class="mt-2 text-sm leading-6 text-[var(--fgColor-muted)]">{{ .Value }}</p>
        </div>
      {{ end }}
    </div>
  </div>
  <p class="max-w-[42rem] text-base leading-7 text-[var(--fgColor-muted)]">{{ .HomeView.Hero.SnapshotNote }}</p>
</div>
{{- end }}
