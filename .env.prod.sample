# Production baseline profile (start here for real deployments)
ENV=production
LISTEN_ADDR=:8080
META_DB_PATH=/var/lib/duck/ducklake_meta.sqlite
LOG_LEVEL=info

# TLS (required in production unless ALLOW_INSECURE_HTTP=true)
TLS_CERT_FILE=/etc/duck/tls/server.crt
TLS_KEY_FILE=/etc/duck/tls/server.key
# ALLOW_INSECURE_HTTP=false

# Auth posture
AUTH_MODE=hybrid
AUTH_ISSUER_URL=https://issuer.example.com
AUTH_AUDIENCE=duck-demo
# AUTH_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# Optional fallback local JWT secret for hybrid/local mode
# JWT_SECRET=replace-with-long-random-secret
AUTH_API_KEY_ENABLED=true
AUTH_API_KEY_HEADER=X-API-Key

# Required in production: 64-char hex key
ENCRYPTION_KEY=replace-with-64-char-hex-key

# Required in production: no wildcard CORS
CORS_ALLOWED_ORIGINS=https://app.example.com

# Optional S3 config (new names preferred)
# S3_KEY_ID=
# S3_SECRET=
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=duck-demo
